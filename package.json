{
  "name": "narae-talk",
  "productName": "나래톡",
  "version": "0.13.0-preview.66",
  "description": "나래 시리즈를 사용하여 교육 업무를 포함한 다양한 업무를 도와주는 에이전트",
  "license": "MIT",
  "author": "인호우",
  "repository": "https://github.com/y5496694/Narae_talk",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "package": "node scripts/package.cjs",
    "cli": "node src/talk-cli.cjs",
    "relay:kakao": "node src/kakao-relay.cjs",
    "guide:build": "node scripts/write-user-guide.cjs",
    "guide:check": "node scripts/write-user-guide.cjs --check",
    "start:talk": "electron . --talk",
    "cli:talk": "node src/talk-cli.cjs",
    "test:talk:desktop": "node tests/talk-desktop.cjs",
    "test:talk:update": "node tests/talk-update-desktop.cjs",
    "start:office": "electron . --office"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "playwright-core": "1.64.1"
  },
  "bin": {
    "narae-office": "src/cli.cjs",
    "narae-talk": "src/talk-cli.cjs"
  },
  "naraeProduct": "talk"
}
